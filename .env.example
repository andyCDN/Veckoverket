# Public browser configuration. Rebuild after changing these values.
# Without an assigned project, existing plans remain in local storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older Supabase projects may use their public anon key instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Google Calendar read-only connection; public OAuth web client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
