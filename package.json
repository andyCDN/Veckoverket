{
  "name": "veckoverket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-with-pdf-reader.mjs dev --hostname 0.0.0.0",
    "build": "node scripts/run-with-pdf-reader.mjs build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e e2e-cloud scripts .github *.ts *.json README.md",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "test:cloud": "playwright test --config=playwright.cloud.config.ts",
    "deploy:recording": "node scripts/deploy-recording.mjs",
    "deploy:linkedin-job": "node scripts/deploy-linkedin-job.mjs",
    "test:linkedin": "playwright test --config=playwright.linkedin.config.ts",
    "scan:jobs": "node scripts/scan-jobs.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@file-viewer/ppt": "1.0.2",
    "@fontsource/anton": "^5.3.0",
    "@supabase/supabase-js": "^2.108.0",
    "fflate": "0.8.3",
    "ical.js": "2.2.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
